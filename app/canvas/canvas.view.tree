$bog_figmol_app_canvas $mol_view
	store $bog_figmol_store
	- \Who else is looking at this site, and where their cursor is
	live $bog_figmol_live
	- \A site opened by somebody else's link is drawn, panned and read, never moved
	editable true
	tool? \select
	- \Everything picked right now. The canvas is the one panel that writes the
	- \whole list — the rest of the editor deals in a single node.
	selection? /string
	- \Node whose caption is being typed right now
	editing? \
	- \Viewport transform. Pan is in screen pixels, applied before the scale.
	zoom? 0.75
	pan_x? 40
	pan_y? 40
	sheet_width 1200
	sheet_height 1600
	text_default @ \Text
	button_default @ \Button
	attr *
		^
		tabindex 0
		figmol_armed <= armed false
		figmol_grab <= grabbing false
	style *
		touch-action \none
		overscroll-behavior \none
	event *
		pointerdown?event <=> pointer_down?event null
		pointermove?event <=> pointer_move?event null
		pointerup?event <=> pointer_up?event null
		pointercancel?event <=> pointer_up?event null
		pointerleave?event <=> pointer_out?event null
		lostpointercapture?event <=> pointer_up?event null
		dblclick?event <=> pointer_edit?event null
		wheel?event <=> wheel_zoom?event null
		contextmenu?event <=> context_menu?event null
	plugins /
		<= Keys $mol_hotkey
			key *
				escape? <=> deselect? null
				delete? <=> drop? null
				backspace? <=> drop? null
	sub /
		<= World $mol_view
			style *
				transform <= world_transform \
			sub /
				- \A page of the site rather than a part of the editor: the palette,
				- \the colours and the family come from the theme of that site, and
				- \the generated project carries the very same ones.
				<= Sheet $bog_figmol_app_sheet
					store <= store
					style *
						^
						width <= sheet_width_style \
						minHeight <= sheet_height_style \
					sub <= shapes /
		- \Guides, rulers, the frame around several elements and the context menu.
		- \Drawn beside the world rather than inside it, in screen pixels: a
		- \hairline has to stay a hairline at any zoom, and a label readable.
		<= Overlay $mol_view
			sub <= overlay /
	Shape* $bog_figmol_app_canvas_shape
		store <= store
		editable <= editable true
		id <= shape_id* \
		selected <= shape_selected* false
		mark <= shape_mark* \
		grips <= shape_grips* false
		editing <= shape_editing* false
		dropping <= shape_dropping* false
		kids <= shape_kids* /$mol_view
		rect <= shape_rect* /number
	- \Pointer of somebody else, moved by a transform in screen pixels: a cursor
	- \is at a place on the page, and the page is drawn at whatever zoom it is.
	Cursor* $bog_figmol_app_canvas_cursor
		color <= cursor_color* \
		mate_name <= cursor_name* \
		style *
			transform <= cursor_transform* \
	- \Rubber band of a selection drag. Lives on the sheet, so it is drawn in
	- \sheet pixels and the viewport transform carries it along.
	Marquee $mol_view
		style *
			left <= marquee_left \
			top <= marquee_top \
			width <= marquee_width \
			height <= marquee_height \
	- \Line the drag has stuck to, drawn across the whole sheet the way every
	- \editor draws it.
	Guide_x $mol_view
		style *
			left <= guide_x_left \
			top <= guide_x_top \
			height <= guide_x_height \
	Guide_y $mol_view
		style *
			top <= guide_y_top \
			left <= guide_y_left \
			width <= guide_y_width \
	- \Distance between the box being dragged and one of its neighbours: a thin
	- \rule with the number of pixels sitting on top of it.
	Measure* $mol_view
		style *
			left <= measure_left* \
			top <= measure_top* \
			width <= measure_width* \
			height <= measure_height* \
		sub /
			<= Measure_label* $mol_view
				sub /
					<= measure_text* \
	- \Frame around several elements at once, with grips that scale the lot of
	- \them. A single element wears its own grips instead.
	Group $mol_view
		attr *
			^
			figmol_group \true
		style *
			left <= group_left \
			top <= group_top \
			width <= group_width \
			height <= group_height \
		sub /
			<= Group_nw $mol_view
				attr *
					^
					figmol_handle \nw
			<= Group_ne $mol_view
				attr *
					^
					figmol_handle \ne
			<= Group_sw $mol_view
				attr *
					^
					figmol_handle \sw
			<= Group_se $mol_view
				attr *
					^
					figmol_handle \se
	- \What the right button opens over whatever it was pressed on.
	Menu $mol_view
		attr *
			^
			figmol_menu \true
		style *
			left <= menu_left \
			top <= menu_top \
		sub /
			<= Menu_copy $mol_button_minor
				click? <=> menu_copy? null
				title <= menu_copy_label @ \Duplicate
			<= Menu_front $mol_button_minor
				click? <=> menu_front? null
				title <= menu_front_label @ \Bring to front
			<= Menu_back $mol_button_minor
				click? <=> menu_back? null
				title <= menu_back_label @ \Send to back
			<= Menu_wrap $mol_button_minor
				click? <=> menu_wrap? null
				title <= menu_wrap_label @ \Wrap in a frame
			<= Menu_drop $mol_button_minor
				click? <=> menu_drop? null
				title <= menu_drop_label @ \Delete
