$bog_figmol_app_inspector $mol_view
	store $bog_figmol_store
	selected? \
	selection /string
	- \Written with the name of an alignment the app is asked to carry out. The
	- \panel has the buttons, the app has the measurements.
	arrange? \
	sub <= rows /$mol_view
	title_many @ \Selected
	title_text @ \Text
	title_image @ \Image
	title_button @ \Button
	title_rect @ \Rectangle
	title_frame @ \Frame
	Head $mol_view
		sub /
			<= kind_title \
	Field_x $bog_figmol_app_inspector_field
		title @ \X
		content /
			<= X $bog_figmol_app_inspector_number
				value? <=> x? +0
	Field_y $bog_figmol_app_inspector_field
		title @ \Y
		content /
			<= Y $bog_figmol_app_inspector_number
				value? <=> y? +0
	Field_w $bog_figmol_app_inspector_field
		title @ \Width
		content /
			<= W $bog_figmol_app_inspector_number
				value? <=> w? +0
	Field_h $bog_figmol_app_inspector_field
		title @ \Height
		content /
			<= H $bog_figmol_app_inspector_number
				value? <=> h? +0
	Field_direction $bog_figmol_app_inspector_field
		title @ \Layout
		content /
			<= Direction $mol_switch
				value? <=> direction? \
				options *
					free @ \Free
					row @ \Row
					column @ \Column
	Field_gap $bog_figmol_app_inspector_field
		title @ \Gap
		content /
			<= Gap $bog_figmol_app_inspector_number
				value? <=> gap? +0
	Field_padding $bog_figmol_app_inspector_field
		title @ \Padding
		content /
			<= Padding $bog_figmol_app_inspector_number
				value? <=> padding? +0
	Field_align $bog_figmol_app_inspector_field
		title @ \Align
		content /
			<= Align $mol_switch
				value? <=> align? \
				options *
					start @ \Start
					center @ \Center
					end @ \End
					stretch @ \Stretch
	Field_text $bog_figmol_app_inspector_field
		title @ \Content
		content /
			<= Text $mol_textarea
				value? <=> text? \
				hint @ \Type here
	Field_label $bog_figmol_app_inspector_field
		title @ \Caption
		content /
			<= Label $mol_string
				value? <=> text? \
	Field_hint $bog_figmol_app_inspector_field
		title @ \Placeholder
		content /
			<= Hint $mol_string
				value? <=> text? \
	Field_note $bog_figmol_app_inspector_field
		title @ \Note
		content /
			<= Note $mol_textarea
				value? <=> note? \
	Field_size $bog_figmol_app_inspector_field
		title @ \Font size
		content /
			<= Size $bog_figmol_app_inspector_number
				value? <=> font_size? +0
	Field_weight $bog_figmol_app_inspector_field
		title @ \Weight
		content /
			<= Weight $mol_switch
				value? <=> weight? \
				options *
					normal @ \Normal
					bold @ \Bold
	Field_text_align $bog_figmol_app_inspector_field
		title @ \Alignment
		content /
			<= Text_align $mol_switch
				value? <=> text_align? \
				options *
					left @ \Left
					center @ \Center
					right @ \Right
	Field_color $bog_figmol_app_inspector_field
		title @ \Color
		content /
			<= Color $mol_string
				value? <=> color? \
				hint \#111827
	Field_back $bog_figmol_app_inspector_field
		title @ \Background
		content /
			<= Back $mol_string
				value? <=> back? \
				hint \#ffffff
	Field_uri $bog_figmol_app_inspector_field
		title @ \Link
		content /
			<= Uri $mol_string
				value? <=> uri? \
				hint \https://
	Field_variant $bog_figmol_app_inspector_field
		title @ \Look
		content /
			<= Variant $mol_switch
				value? <=> variant? \
				options *
					default @ \Solid
					secondary @ \Secondary
					outline @ \Outline
					ghost @ \Ghost
	Field_tone $bog_figmol_app_inspector_field
		title @ \Look
		content /
			<= Tone $mol_switch
				value? <=> variant? \
				options *
					default @ \Solid
					secondary @ \Secondary
					outline @ \Outline
					destructive @ \Danger
	Field_value $bog_figmol_app_inspector_field
		title @ \Value
		content /
			<= Value $bog_figmol_app_inspector_number
				value? <=> progress? +0
	Field_max $bog_figmol_app_inspector_field
		title @ \Maximum
		content /
			<= Max $bog_figmol_app_inspector_number
				value? <=> progress_max? +100
	Field_options $bog_figmol_app_inspector_field
		title @ \Tabs
		content /
			<= Options $mol_string
				value? <=> options? \
				hint \One | Two | Three
	- \Name of the component an instance draws, and the way into its master
	Field_comp $bog_figmol_app_inspector_field
		title @ \Component
		content /
			<= Comp_name $mol_view
				sub /
					<= comp_title \
	Comp_edit $mol_button_minor
		click? <=> comp_edit? null
		sub /
			<= Comp_edit_icon $mol_icon_pencil
			<= comp_edit_label @ \Edit component
	Comp_make $mol_button_minor
		click? <=> comp_make? null
		sub /
			<= Comp_make_icon $mol_icon_puzzle
			<= comp_make_label @ \Make component
	- \Lining several elements up. Drawn as a strip of icons, the way every
	- \editor draws it, and only for a selection that has coordinates of its own.
	Arrange $mol_view
		sub /
			<= Align_left $mol_button_minor
				click? <=> align_left? null
				hint @ \Align left
				sub /
					<= Align_left_icon $mol_icon_align_horizontal_left
			<= Align_hcenter $mol_button_minor
				click? <=> align_hcenter? null
				hint @ \Align centres across
				sub /
					<= Align_hcenter_icon $mol_icon_align_horizontal_center
			<= Align_right $mol_button_minor
				click? <=> align_right? null
				hint @ \Align right
				sub /
					<= Align_right_icon $mol_icon_align_horizontal_right
			<= Align_hspace $mol_button_minor
				click? <=> align_hspace? null
				hint @ \Even out the gaps across
				sub /
					<= Align_hspace_icon $mol_icon_align_horizontal_distribute
			<= Align_top $mol_button_minor
				click? <=> align_top? null
				hint @ \Align top
				sub /
					<= Align_top_icon $mol_icon_align_vertical_top
			<= Align_vcenter $mol_button_minor
				click? <=> align_vcenter? null
				hint @ \Align centres down
				sub /
					<= Align_vcenter_icon $mol_icon_align_vertical_center
			<= Align_bottom $mol_button_minor
				click? <=> align_bottom? null
				hint @ \Align bottom
				sub /
					<= Align_bottom_icon $mol_icon_align_vertical_bottom
			<= Align_vspace $mol_button_minor
				click? <=> align_vspace? null
				hint @ \Even out the gaps down
				sub /
					<= Align_vspace_icon $mol_icon_align_vertical_distribute
	Drop $mol_button_minor
		click? <=> node_drop? null
		sub /
			<= Drop_icon $mol_icon_delete_outline
			<= drop_caption \
	drop_label @ \Delete element
	drop_many_label @ \Delete the selection
