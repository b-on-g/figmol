				value? <=> back? \
				hint \#ffffff
	Field_uri $bog_figmol_app_inspector_field
		title @ \Link
		content /
			<= Uri $mol_string
				value? <=> uri? \
				hint \https://
	Field_variant $bog_figmol_app_inspector_field
		title @ \Look
		content /
			<= Variant $mol_switch
				value? <=> variant? \
				options *
					default @ \Solid
					secondary @ \Secondary
					outline @ \Outline
					ghost @ \Ghost
	Field_tone $bog_figmol_app_inspector_field
		title @ \Look
		content /
			<= Tone $mol_switch
				value? <=> variant? \
				options *
					default @ \Solid
					secondary @ \Secondary
					outline @ \Outline
					destructive @ \Danger
	Field_value $bog_figmol_app_inspector_field
		title @ \Value
		content /
			<= Value $bog_figmol_app_inspector_number
				value? <=> progress? +0
	Field_max $bog_figmol_app_inspector_field
		title @ \Maximum
		content /
			<= Max $bog_figmol_app_inspector_number
				value? <=> progress_max? +100
	Field_options $bog_figmol_app_inspector_field
		title @ \Tabs
		content /
			<= Options $mol_string
				value? <=> options? \
				hint \One | Two | Three
	Drop $mol_button_minor
		click? <=> node_drop? null
		sub /
			<= Drop_icon $mol_icon_delete_outline
			<= drop_label @ \Delete element

$bog_figmol_app_pages $mol_view
	store $bog_figmol_store
	- \Only an editor gets the fields and the buttons; a visitor gets the list
	editable true
	- \Cleared whenever the canvas switches to another page
	selected? \
	page_default @ \Page
	sub <= panels /$mol_view
	Head $mol_view
		sub <= head_content /$mol_view
	Caption $mol_view
		sub /
			<= title @ \Pages
	Add $mol_button_minor
		click? <=> page_add? null
		hint @ \Add a page
		sub /
			<= Add_icon $mol_icon_plus
	List $mol_view
		sub <= rows /
	Field_title $bog_figmol_app_inspector_field
		title @ \Title
		content /
			<= Title $mol_string
				value? <=> current_title? \
	Field_slug $bog_figmol_app_inspector_field
		title @ \Address
		content /
			<= Slug $mol_string
				value? <=> current_slug? \
				hint @ \empty for the entry page
	Drop $mol_button_minor
		click? <=> page_drop? null
		enabled <= droppable false
		sub /
			<= Drop_icon $mol_icon_delete_outline
			<= drop_label @ \Delete page
	Row* $bog_figmol_app_row
		click? <=> page_click*? null
		title <= page_title* \
		active <= page_active* false

$bog_figmol_app_blocks $mol_view
	store $bog_figmol_store
	- \Middle of the viewport in sheet pixels, handed down by the app
	spot /number
	- \Set to whatever was just dropped on the page
	selected? \
	attr *
		^
		figmol_wait <= waiting false
	sub /
		<= Head $mol_view
			sub /
				<= title @ \Components
		<= Kinds $mol_view
			sub <= kind_rows /
		<= Sections_head $mol_view
			sub /
				<= sections_title @ \Sections
		<= Sections $mol_view
			sub <= section_rows /
	Kind* $bog_figmol_app_row
		click? <=> kind_click*? null
		title <= kind_title* \
		enabled <= ready false
	Section* $bog_figmol_app_row
		click? <=> section_click*? null
		title <= section_title* \
		enabled <= ready false

$bog_figmol_app_layers $mol_view
	store $bog_figmol_store
	selected? \
	sub /
		<= Head $mol_view
			sub /
				<= title @ \Layers
		<= List $mol_scroll
			sub /
				<= Tree $mol_view
					sub <= rows /
	Row* $bog_figmol_app_row
		click? <=> row_click*? null
		title <= row_title* \
		active <= row_active* false
		indent <= row_indent* \

- \Left panel of the editor: what page is open, what can be dropped on it, and
- \what is already there.
$bog_figmol_app_side $mol_view
	store $bog_figmol_store
	- \A site opened by somebody else's link keeps the lists and loses the palette
	editable true
	- \Middle of the viewport in sheet pixels, where a dropped block lands
	spot /number
	selected? \
	sub <= panels /$mol_view
	Pages $bog_figmol_app_pages
		store <= store
		editable <= editable true
		selected? <=> selected? \
	Blocks $bog_figmol_app_blocks
		store <= store
		spot <= spot /number
		selected? <=> selected? \
	Layers $bog_figmol_app_layers
		store <= store
		selected? <=> selected? \

$mol_labeler $mol_list
	rows /
		<= Label $mol_view
			minimal_height 32
			sub <= label /$mol_view_content
				<= title
		<= Content $mol_view
			minimal_height 24
			sub <= content /

$mol_form_field $mol_labeler
	attr *
		^
		mol_form_field_state <= state null string
	bids /string
	label /
		<= name \
		<= Bid $mol_view
			sub / <= bid \
	content / <= control null

$mol_row $mol_view

$mol_button_major $mol_button_minor
	theme \$mol_theme_base

$mol_status $mol_view
	status <= title
	minimal_height 24
	minimal_width 0
	sub /
		<= message \

$mol_form $mol_list
	submit_allowed true
	submit_blocked false
	event *
		^
		keydown? <=> keydown? null
	save? null
	message_done @ \Saved
	errors *string
		\Form invalid
			<= form_invalid @ \Form is not valid
	rows /
		<= Body $mol_list
			sub <= body <= form_fields /$mol_form_field
		<= Foot $mol_row
			sub <= foot <= buttons /$mol_view
				<= Submit $mol_button_major
					title <= submit_title @ \Save
					hint <= submit_hint \
					activate? => submit_activate?
					click? <=> submit? null
				<= Result $mol_status
					message <= result? null

$bog_figmol_deploy_publish $mol_list
	- \Repository content: path relative to the root => text of the file.
	files *
	- \Repository name. Must be the one the files were generated for.
	name? \
	- \Token with the repo and workflow scopes. Kept in this browser.
	token? \
	commit_message \Published from Figmol
	repo_descr \Built with Figmol
	rows /
		<= Fields $mol_list
			rows /
				<= Token_field $mol_form_field
					name <= token_name @ \GitHub token
					control <= Token $mol_string
						hint \ghp_xxxxxxxxxxxxxxxxxxxx
						type \password
						value? <=> token? \
				<= Token_hint $mol_view
					sub /
						<= token_hint @ \Never leaves this browser — the only address it is sent to is api.github.com.
						<= Token_link $mol_link
							uri <= token_uri \
							target \_blank
							title <= token_link @ \Create a token
				<= Name_field $mol_form_field
					name <= name_name @ \Repository
					bids /
						<= name_bid \
					control <= Name $mol_string
						hint \mysite
						value? <=> name? \
				<= Name_hint $mol_view
					sub /
						<= name_hint @ \One lowercase word. The site lands on <owner>.github.io/<name>/.
		<= Buttons $mol_row
			sub <= buttons /$mol_view
		<= Conflict $mol_view
			sub <= conflict_rows /string
		<= Problem $mol_view
			sub <= problem_rows /string
		<= Steps $mol_list
			rows <= step_rows /$mol_view
		<= Links $mol_list
			rows <= link_rows /$mol_view
	Publish $mol_button_major
		enabled <= publish_enabled true
		click? <=> publish? null
		title <= publish_label @ \Publish
	Overwrite $mol_button_minor
		click? <=> overwrite? null
		title <= overwrite_label @ \Republish into it
	Step* $mol_row
		attr *
			^
			bog_figmol_deploy_state <= step_state* \wait
		sub /
			<= Step_mark* $mol_view
				sub /
					<= step_mark* \
			<= Step_title* $mol_view
				sub /
					<= step_title* \
			<= Step_note* $mol_view
				sub /
					<= step_note* \
	Link* $mol_link
		uri <= link_uri* \
		target \_blank
		title <= link_label* \
	step_title_login @ \Checking the token
	step_title_repo @ \Preparing the repository
	step_title_push @ \Uploading the sources
	step_title_build @ \Waiting for the build
	step_title_pages @ \Switching Pages on
	step_title_live @ \The site is live
	link_label_site @ \Open the site
	link_label_repo @ \Open the repository
	link_label_run @ \Open the build log
	conflict_hint @ \This account already has a repository with that name. Republishing replaces its files with a new commit — anything committed there by hand is lost.
	nothing_hint @ \There is nothing to publish yet.
	token_missing @ \Paste a token first.
	build_late @ \GitHub did not start a build in time. Open the repository and check the Actions tab.
	build_bad @ \The build did not succeed — open the log to see why.
	pages_late @ \Pages did not switch on. Turn them on for the gh-pages branch in the repository settings.

$bog_figmol_app_start $mol_view
	store $bog_figmol_store
	site_default @ \My site
	page_default @ \Home
	sub /
		<= Title $mol_view
			dom_name \h2
			sub /
				<= title @ \Nothing built here yet
		<= Hint $mol_view
			sub /
				<= hint @ \The site gets a storage of its own, so it can later be handed over by link. Preparing it takes a couple of seconds.
		<= Make $mol_button_major
			click? <=> make? null
			sub /
				<= make_label @ \Create a site

$mol_page $mol_view
	dom_name \article
	attr *
		^
		tabIndex <= tabindex -1
	sub /
		<= Head $mol_view
			minimal_height 64
			dom_name \header
			sub <= head /
				<= Title $mol_view
					dom_name \h1
					sub <= title_content /
						<= Logo null
						<= title
				<= Tools $mol_view
					sub <= tools /$mol_view_content
		<= Body $mol_scroll
			scroll_top? => body_scroll_top?
			sub <= body_content /
				<= Body_content $mol_view
					sub <= body /$mol_view
		<= Foot $mol_view
			dom_name \footer
			sub <= foot /$mol_view

$bog_figmol_deploy $mol_page
	- \Repository content the panel would push, keyed by path.
	files *
	name? \figmoldemo
	title \Figmol publish bench
	body /
		<= Note $mol_view
			sub /
				<= note @ \The files come from the generator run over a fixture site, so the panel can be tried without the editor. Publishing from here really does create a repository on the account the token belongs to.
		<= Publish $bog_figmol_deploy_publish
			files <= files
			name? <=> name? \figmoldemo
		<= Listing_title $mol_view
			sub /
				<= listing_title @ \Files to be pushed
		<= Listing $mol_list
			rows <= listing_rows /$mol_view
	File* $mol_row
		sub /
			<= File_name* $mol_view
				sub /
					<= file_name* \
			<= File_size* $mol_view
				sub /
					<= file_size* \

$bog_figmol_app $mol_view
	store $bog_figmol_store
	title @ \Figmol
	- \Armed tool: select | text | image | button | rect | frame
	tool? \select
	- \Link of the node the canvas frames and the inspector follows
	selected? \
	- \Publishing panel takes the right rail over from the inspector
	publishing? false
	- \Repository the site is pushed into, and the module name of the sources
	publish_name? \
	plugins /
		<= Theme $bog_theme_auto
			theme_light \$mol_theme_calm_light
			theme_dark \$mol_theme_calm_dark
			themes /
				\$mol_theme_calm_light
				\$mol_theme_calm_dark
	sub /
		<= Head $mol_view
			dom_name \header
			sub <= head_tools /$mol_view
		<= Editor $mol_view
			sub <= editor_content /
	Title $mol_view
		dom_name \h1
		sub /
			<= title
	Status $giper_baza_status
	Theme_toggle $bog_theme_toggle
		theme_auto <= Theme
	- \Address of this very site for somebody else. Read only for them until the
	- \owner hands the writing rights out, which is a thing for another day.
	Share $mol_button_copy
		text <= share_uri \
		hint <= share_hint @ \Copy a link that opens this site for reading
		title <= share_label @ \Share
	Publish_toggle $mol_button_minor
		click? <=> publish_toggle? null
		title <= publish_label @ \Publish
	Readonly $mol_view
		sub /
			<= readonly_label @ \Someone else's site — read only
	Mine $mol_link
		arg *
			site null
		title <= mine_label @ \My editor
	Tools $bog_figmol_app_tools
		tool? <=> tool? \select
	Side $bog_figmol_app_side
		store <= store
		editable <= editable true
		spot <= drop_spot /number
		selected? <=> selected? \
	Canvas $bog_figmol_app_canvas
		store <= store
		editable <= editable true
		tool? <=> tool? \select
		selected? <=> selected? \
	Inspector $bog_figmol_app_inspector
		store <= store
		selected? <=> selected? \
	Publish $bog_figmol_deploy_publish
		files <= publish_files *
		name? <=> publish_name? \
	Start $bog_figmol_app_start
		store <= store
