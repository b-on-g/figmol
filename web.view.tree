$bog_figmol_deploy_publish $mol_list
	- \Repository content: path relative to the root => text of the file.
	files *
	- \Repository name. Must be the one the files were generated for.
	name? \
	- \Token with the repo and workflow scopes. Kept in this browser.
	token? \
	commit_message \Published from Figmol
	repo_descr \Built with Figmol
	rows /
		<= Fields $mol_list
			rows /
				<= Token_field $mol_form_field
					name <= token_name @ \GitHub token
					control <= Token $mol_string
						hint \ghp_xxxxxxxxxxxxxxxxxxxx
						type \password
						value? <=> token? \
				<= Token_hint $mol_view
					sub /
						<= token_hint @ \Never leaves this browser — the only address it is sent to is api.github.com.
						<= Token_link $mol_link
							uri <= token_uri \
							target \_blank
							title <= token_link @ \Create a token
				<= Name_field $mol_form_field
					name <= name_name @ \Repository
					bids /
						<= name_bid \
					control <= Name $mol_string
						hint \mysite
						value? <=> name? \
				<= Name_hint $mol_view
					sub /
						<= name_hint @ \One lowercase word. The site lands on <owner>.github.io/<name>/.
		<= Buttons $mol_row
			sub <= buttons /$mol_view
		<= Conflict $mol_view
			sub <= conflict_rows /string
		<= Problem $mol_view
			sub <= problem_rows /string
		<= Steps $mol_list
			rows <= step_rows /$mol_view
		<= Links $mol_list
			rows <= link_rows /$mol_view
	Publish $mol_button_major
		enabled <= publish_enabled true
		click? <=> publish? null
		title <= publish_label @ \Publish
	Overwrite $mol_button_minor
		click? <=> overwrite? null
		title <= overwrite_label @ \Republish into it
	Step* $mol_row
		attr *
			^
			bog_figmol_deploy_state <= step_state* \wait
		sub /
			<= Step_mark* $mol_view
				sub /
					<= step_mark* \
			<= Step_title* $mol_view
				sub /
					<= step_title* \
			<= Step_note* $mol_view
				sub /
					<= step_note* \
	Link* $mol_link
		uri <= link_uri* \
		target \_blank
		title <= link_label* \
	step_title_login @ \Checking the token
	step_title_repo @ \Preparing the repository
	step_title_push @ \Uploading the sources
	step_title_build @ \Waiting for the build
	step_title_pages @ \Switching Pages on
	step_title_live @ \The site is live
	link_label_site @ \Open the site
	link_label_repo @ \Open the repository
	link_label_run @ \Open the build log
	conflict_hint @ \This account already has a repository with that name. Republishing replaces its files with a new commit — anything committed there by hand is lost.
	nothing_hint @ \There is nothing to publish yet.
	token_missing @ \Paste a token first.
	build_late @ \GitHub did not start a build in time. Open the repository and check the Actions tab.
	build_bad @ \The build did not succeed — open the log to see why.
	pages_late @ \Pages did not switch on. Turn them on for the gh-pages branch in the repository settings.

$bog_figmol_app_start $mol_view
	store $bog_figmol_store
	site_default @ \My site
	page_default @ \Home
	sub /
		<= Title $mol_view
			dom_name \h2
			sub /
				<= title @ \Nothing built here yet
		<= Hint $mol_view
			sub /
				<= hint @ \The site gets a storage of its own, so it can later be handed over by link. Preparing it takes a couple of seconds.
		<= Make $mol_button_major
			click? <=> make? null
			sub /
				<= make_label @ \Create a site

$bog_figmol_deploy $mol_page
	- \Repository content the panel would push, keyed by path.
	files *
	name? \figmoldemo
	title \Figmol publish bench
	body /
		<= Note $mol_view
			sub /
				<= note @ \The files come from the generator run over a fixture site, so the panel can be tried without the editor. Publishing from here really does create a repository on the account the token belongs to.
		<= Publish $bog_figmol_deploy_publish
			files <= files
			name? <=> name? \figmoldemo
		<= Listing_title $mol_view
			sub /
				<= listing_title @ \Files to be pushed
		<= Listing $mol_list
			rows <= listing_rows /$mol_view
	File* $mol_row
		sub /
			<= File_name* $mol_view
				sub /
					<= file_name* \
			<= File_size* $mol_view
				sub /
					<= file_size* \

$bog_figmol_app $mol_view
	store $bog_figmol_store
	title @ \Figmol
	- \Armed tool: select | text | image | button | rect | frame
	tool? \select
	- \Link of the node the canvas frames and the inspector follows
	selected? \
	- \Publishing panel takes the right rail over from the inspector
	publishing? false
	- \Repository the site is pushed into, and the module name of the sources
	publish_name? \
	plugins /
		<= Theme $bog_theme_auto
			theme_light \$mol_theme_calm_light
			theme_dark \$mol_theme_calm_dark
			themes /
				\$mol_theme_calm_light
				\$mol_theme_calm_dark
	sub /
		<= Head $mol_view
			dom_name \header
			sub <= head_tools /$mol_view
		<= Editor $mol_view
			sub <= editor_content /
	Title $mol_view
		dom_name \h1
		sub /
			<= title
	Status $giper_baza_status
	Theme_toggle $bog_theme_toggle
		theme_auto <= Theme
	- \Address of this very site for somebody else. Read only for them until the
	- \owner hands the writing rights out, which is a thing for another day.
	Share $mol_button_copy
		text <= share_uri \
		hint <= share_hint @ \Copy a link that opens this site for reading
		title <= share_label @ \Share
	Publish_toggle $mol_button_minor
		click? <=> publish_toggle? null
		title <= publish_label @ \Publish
	Readonly $mol_view
		sub /
			<= readonly_label @ \Someone else's site — read only
	Mine $mol_link
		arg *
			site null
		title <= mine_label @ \My editor
	Tools $bog_figmol_app_tools
		tool? <=> tool? \select
	Side $bog_figmol_app_side
		store <= store
		editable <= editable true
		spot <= drop_spot /number
		selected? <=> selected? \
	Canvas $bog_figmol_app_canvas
		store <= store
		editable <= editable true
		tool? <=> tool? \select
		selected? <=> selected? \
	Inspector $bog_figmol_app_inspector
		store <= store
		selected? <=> selected? \
	Publish $bog_figmol_deploy_publish
		files <= publish_files *
		name? <=> publish_name? \
	Start $bog_figmol_app_start
		store <= store
